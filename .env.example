# Admin password for every page and API route except the public ones (sign-in, health). 12 characters or more.
# Required outside the demo. Without it the admin pages stay closed and /login shows a setup page.
LOOOT_INTENT_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# LOOOT_INTENT_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# LOOOT_INTENT_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# LOOOT_INTENT_COOKIE_SECURE=
# Optional. Most one web run may spend, in dollars. Default 5. The browser cannot raise it.
# LOOOT_INTENT_MAX_RUN_USD=5
# looot key for real runs. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Optional. Overrides the API base, default https://api.looot.ai
LOOOT_API_URL=
# Optional. Scoring config used by the web UI, default config/intent.config.json
LOOOT_INTENT_CONFIG=
# Optional. Folder for the saved run, default .looot-intent
LOOOT_INTENT_DIR=
# Optional. Set to 1 to run the web UI on sample data with no sign-in. Refuses to start next to a LOOOT_TOKEN or a saved run unless an admin password is set.
LOOOT_INTENT_DEMO=
