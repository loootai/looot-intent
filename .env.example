# looot key for real runs. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Optional. Overrides the API base, default https://api.looot.ai
LOOOT_API_URL=
# Optional. Scoring config used by the web UI, default config/intent.config.json
LOOOT_INTENT_CONFIG=
# Optional. Folder for the saved run, default .looot-intent
LOOOT_INTENT_DIR=
# Optional. Set to 1 to run the web UI on sample data
LOOOT_INTENT_DEMO=
